<UserControl x:Class="MI50FanControl.Views.CurveEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:MI50FanControl.Converters"
             xmlns:ctrl="clr-namespace:MI50FanControl.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Title & Profile Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc CurveEditorTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{loc:Loc SmoothingHysteresis}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Profile Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding NewProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ "/>
                            <TextBlock Text="{loc:Loc NewProfile}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DuplicateProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 "/>
                            <TextBlock Text="{loc:Loc DuplicateProfile}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteProfileCommand}" Style="{StaticResource DangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️ "/>
                            <TextBlock Text="{loc:Loc DeleteProfile}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Layout: Profile Picker & Graph -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Profiles List -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc CurveProfiles}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="LocalizedName" 
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#30363D"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#21262D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Right Column: Interactive Visual Graph -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc CurvePreview}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                        
                        <!-- Visual Graph Control -->
                        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Height="220">
                            <ctrl:CurveGraphControl x:Name="GraphVisualizer" Profile="{Binding SelectedProfile}" CurrentTemperature="{Binding TestTemperature}"/>
                        </Border>

                        <TextBlock Text="{loc:Loc CurveInteractiveHint}" 
                                   Foreground="#38BDF8" FontSize="11" Margin="0,6,0,0"/>

                        <!-- Live Curve Test Slider -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{loc:Loc TestTempLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding TestTemperature}" Style="{StaticResource ModernSlider}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding TestTemperatureText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" Width="45" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,16,0"/>
                            
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc OutputSpeedLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CalculatedOutputSpeedText}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Curve Points Node Editor -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc CurvePoints}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding AddPointCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕ "/>
                                    <TextBlock Text="{loc:Loc AddPoint}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemovePointCommand}" Style="{StaticResource DangerButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➖ "/>
                                    <TextBlock Text="{loc:Loc RemovePoint}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Points Data Grid / List -->
                    <ItemsControl ItemsSource="{Binding Points}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161B22" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc TempLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Temperature, StringFormat={}{0:F0}°C}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <Slider Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding Temperature}" Style="{StaticResource ModernSlider}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc FanSpeedLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding FanSpeedPercent, StringFormat={}{0:F0}%}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </StackPanel>

                                        <Slider Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding FanSpeedPercent}" Style="{StaticResource ModernSlider}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Smoothing & Hysteresis Algorithm Settings -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc SmoothingHysteresis}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>

                    <!-- Hysteresis -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc HysteresisLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0.5" Maximum="5.0" Value="{Binding Hysteresis}" Style="{StaticResource ModernSlider}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Hysteresis, StringFormat={}{0:F1}°C}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Smoothing -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc SmoothingLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="1.0" Maximum="20.0" Value="{Binding Smoothing}" Style="{StaticResource ModernSlider}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Smoothing, StringFormat={}{0:F0}%/s}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save Changes Button -->
            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="24,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾 "/>
                    <TextBlock Text="{loc:Loc SaveProfile}"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
