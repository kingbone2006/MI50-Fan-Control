<Window x:Class="MI50FanControl.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cài Đặt AMD MI50 / Radeon PRO VII Fan Controller" 
        Height="580" Width="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D1117"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Modern Segmented Language Toggle RadioButton Style -->
        <Style x:Key="LangToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#21262D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo & Titles -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="AppLogoImage" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" Text="Cài Đặt MI50 Fan Control" FontWeight="Bold" FontSize="18" Foreground="#F0F6FC"/>
                    <TextBlock x:Name="HeaderSubtitleText" Text="Tác giả: Vũ Quốc Hải • AMD Radeon Instinct MI50 / Radeon PRO VII" FontSize="12" Foreground="#8B949E"/>
                </StackPanel>
            </StackPanel>

            <!-- Language Segmented Toggle -->
            <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangViRadio" Content="🇻🇳 Tiếng Việt" IsChecked="True" Checked="LangRadio_Checked"
                                 GroupName="LangGroup" Style="{StaticResource LangToggleStyle}" Margin="0,0,2,0"/>
                    <RadioButton x:Name="LangEnRadio" Content="🇺🇸 English" Checked="LangRadio_Checked"
                                 GroupName="LangGroup" Style="{StaticResource LangToggleStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Body Step 1: Configuration & Install Path -->
        <Border x:Name="Step1Panel" Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <!-- Runtime Prerequisites Check Card -->
                <Border x:Name="PrereqCard" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PrereqIcon" Grid.Column="0" Text="✅" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PrereqTitle" Text="Môi trường .NET 8.0 Desktop Runtime: Đã Sẵn Sàng" FontWeight="Bold" FontSize="13" Foreground="#10B981"/>
                            <TextBlock x:Name="PrereqSubtext" Text="Hệ thống đã có đầy đủ thư viện cần thiết để vận hành ứng dụng." FontSize="11" Foreground="#8B949E" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DownloadDotNetBtn" Content="📥 Tải .NET 8 Ngay" Click="DownloadDotNetBtn_Click" Visibility="Collapsed"
                                    Background="#00D2FF" Foreground="#0D1117" FontWeight="Bold" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button x:Name="RecheckBtn" Content="🔄 Kiểm Tra Lại" Click="RecheckBtn_Click" Visibility="Collapsed"
                                    Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="10,6" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="InstallPathLabel" Text="Thư mục cài đặt phần mềm:" FontWeight="SemiBold" FontSize="13" Foreground="#F0F6FC" Margin="0,0,0,8"/>
                
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" FontSize="13" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="10,6" VerticalAlignment="Center"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="Duyệt..." Click="BrowseBtn_Click" 
                            Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="14,6" Margin="8,0,0,0" Cursor="Hand"/>
                </Grid>

                <TextBlock x:Name="OptionsLabel" Text="Tùy chọn bổ sung:" FontWeight="SemiBold" FontSize="13" Foreground="#F0F6FC" Margin="0,0,0,8"/>
                <CheckBox x:Name="DesktopShortcutCheck" Content="Tạo biểu tượng lối tắt ngoài màn hình (Desktop Shortcut)" IsChecked="True" Foreground="#F0F6FC" FontSize="12" Margin="0,0,0,10" Cursor="Hand"/>
                <CheckBox x:Name="StartWithWindowsCheck" Content="Khởi động cùng Windows khi bật máy (Start with Windows)" IsChecked="True" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                
                <TextBlock x:Name="StartWithWindowsHint" Text="💡 Đã tự động tích chọn khởi động cùng Windows để tự động tối ưu quạt khi mở máy." Foreground="#8B949E" FontSize="11" Margin="22,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body Step 2: Progress -->
        <Border x:Name="Step2Panel" Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="20" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProgressStatusText" Text="Đang giải nén và cài đặt các tập tin hệ thống..." FontWeight="SemiBold" FontSize="14" Foreground="#F0F6FC" Margin="0,0,0,12"/>
                <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="#00D2FF" Background="#30363D" Margin="0,0,0,8"/>
                <TextBlock x:Name="ProgressSubText" Text="Đang nạp trình điều khiển SuperIO &amp; thiết lập tự khởi động..." FontSize="12" Foreground="#8B949E"/>
            </StackPanel>
        </Border>

        <!-- Body Step 3: Donate Screen (VietQR or Ko-fi) -->
        <Border x:Name="DonatePanel" Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="Collapsed">
            <Grid>
                <!-- 3A: Vietnamese VietQR Mode -->
                <Grid x:Name="VietQrContainer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="DonateQrImage" Height="220" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DonateTitleText" Text="☕ Mời Tác Giả Ly Cafe Ủng Hộ Dự Án" FontWeight="Bold" FontSize="15" Foreground="#F0F6FC" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DonateDescText" Text="Nếu phần mềm giúp ích cho công việc và làm mát hiệu quả GPU của bạn, hãy quét mã QR ủng hộ tác giả một ly cafe để tiếp tục duy trì &amp; phát triển dự án nhé! ❤️" 
                                   TextWrapping="Wrap" FontSize="12" Foreground="#8B949E" LineHeight="18" Margin="0,0,0,10"/>

                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🏦 Ngân Hàng Phương Đông (OCB)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                <TextBlock Text="STK: 0200100000542007" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,2,0,0"/>
                                <TextBlock Text="Chủ TK: VU QUOC HAI" FontSize="11" Foreground="#8B949E"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DonatedBtn" Content="❤️ Tôi Đã Ủng Hộ" Click="DonatedBtn_Click" 
                                    Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,10,0"/>
                            <Button x:Name="NoMoneyBtn" Content="😅 Tôi Không Có Tiền" Click="NoMoneyBtn_Click" 
                                    Background="#21262D" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1" Padding="14,8" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 3B: English Ko-fi Mode -->
                <Grid x:Name="KofiContainer" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="☕ Buy the Creator a Coffee on Ko-fi" FontWeight="Bold" FontSize="17" Foreground="#F0F6FC" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="If this application helps keep your AMD Radeon Instinct MI50 / Radeon PRO VII cool and quiet, please consider supporting the creator on Ko-fi to help maintain and improve this project! ❤️" 
                                   TextWrapping="Wrap" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="18" Margin="0,0,0,18"/>

                        <!-- Ko-fi Link Card -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💖 Ko-fi Page:" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="https://ko-fi.com/kingbone2006" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                                <Button Content="☕ Open Ko-fi Page" Click="OpenKofiBtn_Click" 
                                        Background="#FF5E5B" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,8" HorizontalAlignment="Center" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="DonatedBtnEn" Content="❤️ I Have Supported" Click="DonatedBtn_Click" 
                                    Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="16,8" Cursor="Hand" Margin="0,0,12,0"/>
                            <Button x:Name="NoMoneyBtnEn" Content="😅 I Don't Have Money" Click="NoMoneyBtn_Click" 
                                    Background="#21262D" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1" Padding="16,8" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Body Step 4: Star GitHub Repo Screen -->
        <Border x:Name="StarPanel" Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StarTitleText" Text="⭐ Tặng 1 Sao (Star) Trên GitHub Ủng Hộ Dự Án" FontWeight="Bold" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="StarDescText" Text="Không sao cả bạn nhé! Bạn chỉ cần bấm tặng 1 Sao (Star) cho dự án trên GitHub là đã giúp đỡ tác giả rất nhiều rồi! 🌟" 
                           TextWrapping="Wrap" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>

                <!-- Star Screenshot Image Guide -->
                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Image x:Name="StarGuideImage" Height="48" Stretch="Uniform"/>
                </Border>

                <!-- Link -->
                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16" Cursor="Hand">
                    <Hyperlink NavigateUri="https://github.com/kingbone2006/MI50-Fan-Control" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="🔗 https://github.com/kingbone2006/MI50-Fan-Control" Foreground="#58A6FF" FontSize="12" FontWeight="SemiBold"/>
                    </Hyperlink>
                </TextBlock>

                <!-- Countdown Continue Button -->
                <Button x:Name="StarContinueBtn" Content="⏳ Vui lòng chờ (10s)..." IsEnabled="False" Click="StarContinueBtn_Click" 
                        Background="#21262D" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1" FontWeight="Bold" Padding="20,10" HorizontalAlignment="Center" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Body Step 5: Thank You & Finish Screen -->
        <Border x:Name="ThankYouPanel" Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="20" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ThankYouTitleText" Text="🎉 Cảm Ơn Bạn Rất Nhiều!" FontWeight="Bold" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="ThankYouDescText" Text="Sự đồng hành và ủng hộ của bạn là nguồn động lực to lớn giúp tác giả tiếp tục phát triển &amp; tối ưu MI50 Fan Control ngày một hoàn thiện hơn! ❤️" 
                           TextWrapping="Wrap" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="18" Margin="0,0,0,20"/>

                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                    <CheckBox x:Name="LaunchAppCheck" Content="Khởi chạy AMD MI50 Fan Control ngay bây giờ" IsChecked="True" Foreground="#F0F6FC" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="v1.0.0 • Made with ❤️ by kingbone2006" Foreground="#6E7681" FontSize="11" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelBtn" Content="Hủy Bỏ" Click="CancelBtn_Click" 
                        Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="16,8" Cursor="Hand" Margin="0,0,10,0"/>

                <Button x:Name="InstallBtn" Content="Cài Đặt Ngay (Install)" Click="InstallBtn_Click" 
                        Background="#00D2FF" Foreground="#0D1117" FontWeight="Bold" BorderThickness="0" Padding="20,8" Cursor="Hand"/>

                <Button x:Name="FinishBtn" Content="🚀 Hoàn Tất &amp; Khởi Chạy (Finish)" Click="FinishBtn_Click" Visibility="Collapsed"
                        Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="22,8" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
